<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Kanesumi.SecW.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  WinUI 2 控件样式。必须是第一项 —— 它定义了下文被覆盖的那些键。
                  参 AGENTS.md 铁律 1：用 WinUI 2，不用 WinUI 3。
                -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- Kanesumi Design token（正典落地取值） -->
                <ResourceDictionary Source="Themes/KanesumiTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              直角是 Kanesumi 的几何身份（正典 §Ⅲ.1）。

              这两个全局资源控制**全部**控件的圆角 —— UWP 默认 ControlCornerRadius=4
              (Button/TextBox/ListView…)、OverlayCornerRadius=8 (Flyout/Dialog/TeachingTip)。
              归零即得直角，**不需要重写任何控件模板**。

              依据：https://learn.microsoft.com/en-us/windows/apps/design/signature-experiences/geometry
                "The default corner radii are controlled by two global resources …
                 You can override these values in your App.xaml to change the
                 rounding across all controls in your app."

              这里而不是逐控件设 CornerRadius="0"：逐控件必然遗漏，
              新增控件时会忘。参 AGENTS.md 铁律 2。
            -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
