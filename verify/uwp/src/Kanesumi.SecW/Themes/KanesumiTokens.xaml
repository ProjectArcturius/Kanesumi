<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Kanesumi Design —— 落地 token。

      正典：Ether monorepo `docs/KANESUMI_DESIGN.md`
      取值来源：`kanesumi-core/src/colors.rs`（Rust 桌面扇区）

      ⚠ 平台分歧（必须知道）：正典写「OLED 纯黑 #000000」，Android 扇区严格遵守，
      而 Ether 桌面扇区用 #1A1A1A；强调色 likewise（#2E67B5 蓝 vs #E57812 橙金）。
      **没有任何文档解释这个分歧。** 本扇区跟随**桌面扇区** —— 一致比各自为政重要。
      参 AGENTS.md 铁律 3。
    -->

    <!-- ── 色板 ─────────────────────────────────────────────────────────
         正典铁律：深底 + 灰阶分层 + **单一强调色**。一屏一色。
    -->
    <Color x:Key="KanesumiBackgroundColor">#1A1A1A</Color>
    <Color x:Key="KanesumiSurfaceColor">#242424</Color>
    <Color x:Key="KanesumiSurfaceVariantColor">#2E2E2E</Color>
    <Color x:Key="KanesumiDividerColor">#3A3A3A</Color>

    <!-- 单一强调色。整个应用只有这一个彩色。 -->
    <Color x:Key="KanesumiPrimaryColor">#E57812</Color>
    <Color x:Key="KanesumiFocusStrokeColor">#FFA626</Color>

    <Color x:Key="KanesumiOnBackgroundColor">#F0F0F0</Color>
    <Color x:Key="KanesumiOnSurfaceColor">#F0F0F0</Color>
    <Color x:Key="KanesumiOnSurfaceVariantColor">#9AA0A6</Color>

    <!-- 按下反馈：白 10% 叠加。正典：直角闪切取代 M3 ripple。 -->
    <Color x:Key="KanesumiPressTintColor">#1AFFFFFF</Color>

    <!-- ── 画刷 ─────────────────────────────────────────────────────────
         正典铁律 6：无渐变、无阴影。纵深靠明暗，不靠阴影。
         因此这里**只有纯色画刷**，没有 LinearGradientBrush / AcrylicBrush。
    -->
    <SolidColorBrush x:Key="KanesumiBackgroundBrush" Color="{StaticResource KanesumiBackgroundColor}" />
    <SolidColorBrush x:Key="KanesumiSurfaceBrush" Color="{StaticResource KanesumiSurfaceColor}" />
    <SolidColorBrush x:Key="KanesumiSurfaceVariantBrush" Color="{StaticResource KanesumiSurfaceVariantColor}" />
    <SolidColorBrush x:Key="KanesumiDividerBrush" Color="{StaticResource KanesumiDividerColor}" />
    <SolidColorBrush x:Key="KanesumiPrimaryBrush" Color="{StaticResource KanesumiPrimaryColor}" />
    <SolidColorBrush x:Key="KanesumiOnBackgroundBrush" Color="{StaticResource KanesumiOnBackgroundColor}" />
    <SolidColorBrush x:Key="KanesumiOnSurfaceBrush" Color="{StaticResource KanesumiOnSurfaceColor}" />
    <SolidColorBrush x:Key="KanesumiOnSurfaceVariantBrush" Color="{StaticResource KanesumiOnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="KanesumiPressTintBrush" Color="{StaticResource KanesumiPressTintColor}" />

    <!-- ── 字号刻度 ─────────────────────────────────────────────────────
         语义轴（偏好用于新代码 —— 表达「这段文字在页面上是什么角色」）。
         数值与 `kanesumi-core/src/typography.rs` 及 Android 扇区**完全一致**
         （这是罕见的跨平台一致点，不要各自改）。

         CJK 注意：每个样式都显式带行高，因为中文默认行距过松。
         上游有断言 body.line_height / body.size < 1.5。
    -->
    <x:Double x:Key="KanesumiPageHeadingSize">34</x:Double>
    <x:Double x:Key="KanesumiPageHeadingLineHeight">42</x:Double>
    <x:Double x:Key="KanesumiTitleSize">22</x:Double>
    <x:Double x:Key="KanesumiTitleLineHeight">28</x:Double>
    <x:Double x:Key="KanesumiBodySize">15</x:Double>
    <x:Double x:Key="KanesumiBodyLineHeight">22</x:Double>
    <x:Double x:Key="KanesumiCaptionSize">13</x:Double>
    <x:Double x:Key="KanesumiCaptionLineHeight">18</x:Double>
    <x:Double x:Key="KanesumiLabelSize">11</x:Double>
    <x:Double x:Key="KanesumiLabelLineHeight">14</x:Double>

    <!-- ── 间距 ─────────────────────────────────────────────────────────
         4px 网格（上游 `Spacing::base4()`）。
         注意：这是 Rust 桌面扇区的纪律；Android 扇区没有间距 token，
         全是调用点字面量 —— 本扇区跟随 Rust 侧。
    -->
    <x:Double x:Key="KanesumiSpace4">4</x:Double>
    <x:Double x:Key="KanesumiSpace8">8</x:Double>
    <x:Double x:Key="KanesumiSpace12">12</x:Double>
    <x:Double x:Key="KanesumiSpace16">16</x:Double>
    <x:Double x:Key="KanesumiSpace24">24</x:Double>
    <x:Double x:Key="KanesumiSpace32">32</x:Double>

</ResourceDictionary>
