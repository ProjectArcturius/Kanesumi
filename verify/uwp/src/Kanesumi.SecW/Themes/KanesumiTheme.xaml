<?xml version="1.0" encoding="utf-8"?>
<!--
  Kanesumi Design · UWP 控件画刷覆盖

  做法：**覆盖 UWP 原有的键**，而不是另起一套画刷让控件去引用。
  这样系统控件（Button / ListView / TextBox / ComboBox / ScrollBar…）默认就长成
  Kanesumi 的样子，不需要给每个控件写 Style —— 参正典铁律 1「默认即语言」。

  键名取自 Windows SDK 的主题资源字典：
    C:\Program Files (x86)\Windows Kits\10\DesignTime\CommonConfiguration\
      Neutral\UAP\10.0.26100.0\Generic\themeresources.xaml
  UWP 时代的控件画刷是 SystemControl* 系列（不是 WinUI 3 的
  ControlFillColor*/TextFillColor* —— 那是 Fluent 时代的命名）。

  只有 Default（深色）与 Light 两态；正典说是二态，不多不少。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ══ 深色（默认）—— Kanesumi 的主要形态 ──────────────────────
             正典：深底 + 灰阶分层 + 单一强调色。OLED 纯黑 #000000 是正典字面值，
             但桌面扇区（Ether）用 #1A1A1A —— 本工程跟随桌面扇区，保持一致。
        -->
        <ResourceDictionary x:Key="Default">

            <!-- 背景层次 -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#242424" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#242424" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#242424" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#1A1A1A" />

            <!-- 分隔线 -->
            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#9AA0A6" />

            <!-- 文本 -->
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#F0F0F0" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush" Color="#F0F0F0" />

            <!-- 单一强调色（#E57812）。整个应用只有这一个彩色。 -->
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#E57812" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#E57812" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E57812" />

            <!--
              列表项状态。
              正典：按下反馈是**直角闪切**，不是 M3 ripple。UWP 的 ListView 用
              背板色变化表达 hover/press/selected —— 与「闪切」同源，直接沿用，
              只把颜色换成 Kanesumi 的取值。
              selected 用 primary 叠 alpha（正典：明暗变化走 tint 叠加）。
            -->
            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#99E57812" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#CCE57812" />

            <!-- 禁用 -->
            <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="#242424" />
            <SolidColorBrush x:Key="SystemControlDisabledTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlForegroundTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlHighlightTransparentBrush" Color="Transparent" />

            <!-- 焦点框：正典 focus_stroke = #FFA626 -->
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFA626" />

        </ResourceDictionary>

        <!-- ══ 浅色 —— 正典说是二态，不多不少 ──────────────────────────
             注意：正典的浅色只在 Android 与 Rust 侧都**未实现**（上游标注为
             「正典有、实现无」）。这里给出取值，但深色才是主要形态。
        -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="#F5F6F7" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="#EEEEEE" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#F9FAFB" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="#81858C" />

            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#0F1115" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush" Color="#FFFFFF" />

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#E57812" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#E57812" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#E57812" />

            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#99E57812" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#CCE57812" />

            <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="#F5F6F7" />
            <SolidColorBrush x:Key="SystemControlDisabledTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlForegroundTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlHighlightTransparentBrush" Color="Transparent" />

            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFA626" />

        </ResourceDictionary>

        <!-- ══ 高对比度 ────────────────────────────────────────────────
             必须提供。UWP 要求 ThemeDictionaries 为**每个存在的主题**给出同一组键，
             缺一个就会在 XAML 解析期抛异常（表现为启动即崩、且事件日志里没有消息）。

             这里的取值刻意**不覆盖**高对比度 —— 那是无障碍设置，正典铁律 7
             「无障碍不可妥协」高于视觉一致性。所以直接映射到系统色。
        -->
        <ResourceDictionary x:Key="HighContrast">

            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumLowBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumLowBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundChromeWhiteBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="SystemControlDisabledBaseLowBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SystemControlDisabledTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlForegroundTransparentBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SystemControlHighlightTransparentBrush" Color="Transparent" />

            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
      Kanesumi 自定义 token —— 系统没有对应键的那些（字号、间距、强调条宽度）。
      控件画刷走上表，这些是应用层用的。
    -->
    <Color x:Key="KanesumiPrimaryColor">#E57812</Color>
    <SolidColorBrush x:Key="KanesumiPrimaryBrush" Color="#E57812" />
    <SolidColorBrush x:Key="KanesumiOnSurfaceVariantBrush" Color="#9AA0A6" />

    <!-- 字号刻度。与 Rust / Android 两侧完全一致（罕见的跨平台一致点）。 -->
    <x:Double x:Key="KanesumiPageHeadingSize">34</x:Double>
    <x:Double x:Key="KanesumiTitleSize">22</x:Double>
    <x:Double x:Key="KanesumiBodySize">15</x:Double>
    <x:Double x:Key="KanesumiCaptionSize">13</x:Double>
    <x:Double x:Key="KanesumiLabelSize">11</x:Double>

    <!-- 4px 间距网格（上游 Spacing::base4） -->
    <x:Double x:Key="KanesumiSpace4">4</x:Double>
    <x:Double x:Key="KanesumiSpace8">8</x:Double>
    <x:Double x:Key="KanesumiSpace12">12</x:Double>
    <x:Double x:Key="KanesumiSpace16">16</x:Double>
    <x:Double x:Key="KanesumiSpace24">24</x:Double>
    <x:Double x:Key="KanesumiSpace32">32</x:Double>

    <!-- 强调条宽度 —— 设计语言的签名图案（直角切一切） -->
    <x:Double x:Key="KanesumiAccentBarWidth">3</x:Double>

</ResourceDictionary>
