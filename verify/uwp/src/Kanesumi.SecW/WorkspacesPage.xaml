<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,32,24,24">
        <StackPanel Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="工作区"
                           FontSize="{StaticResource KanesumiPageHeadingSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="顶栏就是本页第一项 —— 正典约定，不是独立 chrome"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
            </StackPanel>

            <!-- 直角网格：Fixed / Auto / Star 三种列宽都用到，验证布局原语 -->
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="标识"
                           FontSize="{StaticResource KanesumiLabelSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="路径"
                           FontSize="{StaticResource KanesumiLabelSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="会话"
                           FontSize="{StaticResource KanesumiLabelSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />

                <!-- 数据行：靠分隔线分层，不靠阴影 -->
                <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1"
                           Fill="{ThemeResource SystemControlForegroundBaseLowBrush}"
                           VerticalAlignment="Top" />

                <Border Grid.Row="2" Grid.Column="0" Width="4" Height="20"
                        Background="{StaticResource KanesumiPrimaryBrush}"
                        HorizontalAlignment="Left" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Projects/arc-deck"
                           FontSize="{StaticResource KanesumiBodySize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="3"
                           FontSize="{StaticResource KanesumiBodySize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
            </Grid>

            <!-- 说明：为什么这里不做多面板 chrome -->
            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="0" Padding="14,12">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于布局" FontSize="{StaticResource KanesumiCaptionSize}"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               FontSize="{StaticResource KanesumiLabelSize}"
                               Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                               Text="正典反对的是视觉上的 chrome（边框、背板、分割线），不是导航结构。所以 NavigationView 与 Frame 照用，只把它们的外观压平。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
