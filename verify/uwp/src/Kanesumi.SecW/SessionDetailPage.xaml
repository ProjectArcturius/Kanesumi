<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.SessionDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      会话详情。

      正典约定的落地：

      - **详情页无顶栏 chrome**：没有 Page.TopAppBar，返回按钮是页面内容的第一项。
      - **顶栏 = 滚动列表第一项**：标题随内容滚动，不固定在顶上。
      - **底部叠层是悬浮 overlay**：输入框画在内容之上，内容侧自己留白
        （这里是 ListView 的 Footer 撑高，等价于 MetroBottomStack 的效果）。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ 内容 ══════════════════════════════════════════════════ -->
        <ListView
            x:Name="TurnList"
            Grid.Row="0"
            Padding="0"
            SelectionMode="None"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource KanesumiFlatRowStyle}">

            <!-- 顶栏就是列表第一项：返回 + 标题 + 元信息 -->
            <ListView.Header>
                <StackPanel Padding="24,20,24,8" Spacing="10">
                    <Button
                        Click="OnBackClick"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72B;" FontSize="12"
                                      Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                            <TextBlock Text="返回" FontSize="{StaticResource KanesumiCaptionSize}"
                                       Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        x:Name="TitleText"
                        FontSize="{StaticResource KanesumiTitleSize}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

                    <TextBlock
                        x:Name="MetaText"
                        FontSize="{StaticResource KanesumiLabelSize}"
                        Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />

                    <!-- 3px 强调条 —— 设计语言的签名图案 -->
                    <Rectangle Height="3" Width="40" HorizontalAlignment="Left"
                               Fill="{StaticResource KanesumiPrimaryBrush}" />
                </StackPanel>
            </ListView.Header>

            <!--
              这里放静态的对话示意。真实的流式渲染需要 DSH 协议客户端，
              那是产品的事，不是验证工程的事 —— 但它足以验证排版与观感。
            -->
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="24,10,24,10" />
                </DataTemplate>
            </ListView.ItemTemplate>

            <StackPanel Padding="24,8,24,24" Spacing="18">
                <!-- 用户回合 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="你" FontSize="{StaticResource KanesumiLabelSize}"
                               Foreground="{StaticResource KanesumiPrimaryBrush}" />
                    <TextBlock
                        Text="Arc Deck 的 IME 探针结果如何？中文能不能打进去？"
                        FontSize="{StaticResource KanesumiBodySize}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                </StackPanel>

                <!-- 助手回合 -->
                <StackPanel Spacing="6">
                    <TextBlock Text="助手" FontSize="{StaticResource KanesumiLabelSize}"
                               Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                    <TextBlock
                        Text="能。微软拼音在自研 Win32 事件循环里正确组合：逐键推进 z → zh → zho → zhon → zhong，组合串带橙色下划线渲染，与已提交文本视觉分明。"
                        FontSize="{StaticResource KanesumiBodySize}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

                    <!-- 工具调用卡片 —— 直角、无阴影、靠明暗分层 -->
                    <Border
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Padding="14,12">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE756;" FontSize="12"
                                          Foreground="{StaticResource KanesumiPrimaryBrush}" />
                                <TextBlock Text="pwsh" FontSize="{StaticResource KanesumiCaptionSize}"
                                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                                <TextBlock Text="cargo test -p arc-deck-shell"
                                           FontSize="{StaticResource KanesumiLabelSize}"
                                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 代码块：等宽、直角、比表面更深的底 -->
                            <Border Background="{ThemeResource SystemControlBackgroundBaseMediumLowBrush}"
                                    CornerRadius="0" Padding="12,10">
                                <TextBlock
                                    FontFamily="Consolas"
                                    FontSize="{StaticResource KanesumiCaptionSize}"
                                    TextWrapping="NoWrap"
                                    Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                    Text="test result: ok. 21 passed; 0 failed; 0 ignored" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- InfoBar —— WinUI 2 控件，验证它是否也走了圆角归零 -->
                <muxc:InfoBar
                    IsOpen="True"
                    Severity="Success"
                    Title="验证通过"
                    Message="消息泵 → InputEvent → App::handle_input → 渲染，全链路。" />
            </StackPanel>
        </ListView>

        <!-- ══ 输入区（悬浮 overlay）═════════════════════════════════ -->
        <Border
            Grid.Row="1"
            Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 用微软拼音在这里试中文输入 —— 这是本工程要验证的 IME 通路 -->
                <TextBox
                    x:Name="Composer"
                    Grid.Column="0"
                    PlaceholderText="用微软拼音输入中文，验证 IME 通路…"
                    AcceptsReturn="False"
                    FontSize="{StaticResource KanesumiBodySize}"
                    KeyDown="OnComposerKeyDown" />

                <Button
                    Grid.Column="1"
                    Content="发送"
                    Click="OnSendClick"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
