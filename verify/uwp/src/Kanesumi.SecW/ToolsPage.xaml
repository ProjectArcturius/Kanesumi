<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      控件覆盖台。

      目的很具体：ControlCornerRadius / OverlayCornerRadius 只覆盖**走这两个资源**
      的控件。并非所有控件都走 —— 自绘控件、部分模板、Flyout 内容各有各的路径。
      一次摆出来，肉眼查一遍，没归零的记进 docs/UWP_FEEDBACK.md。

      这不是「演示页」，是**取证页**。所以控件尽量密、尽量全。
    -->
    <ScrollViewer Padding="24,32,24,32">
        <StackPanel Spacing="28">

            <StackPanel Spacing="6">
                <TextBlock Text="工具与控件"
                           FontSize="{StaticResource KanesumiPageHeadingSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="逐项核验直角是否生效 · based on Kanesumi Design"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
            </StackPanel>

            <!-- ── 基础控件 ─────────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="基础" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="普通" />
                    <Button Content="强调" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="禁用" IsEnabled="False" />
                    <ToggleButton Content="切换" />
                    <HyperlinkButton Content="链接" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox PlaceholderText="文本框" Width="200" />
                    <CheckBox Content="复选" />
                    <RadioButton Content="单选" />
                    <ComboBox Width="140" SelectedIndex="0">
                        <ComboBoxItem Content="一" />
                        <ComboBoxItem Content="二" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Slider Width="200" Minimum="0" Maximum="100" Value="40" />
                    <ToggleSwitch OnContent="开" OffContent="关" IsOn="True" />
                    <ProgressBar Value="45" Width="180" />
                    <muxc:ProgressRing IsActive="True" Width="24" Height="24" />
                </StackPanel>
            </StackPanel>

            <!-- ── WinUI 2 控件（须 muxc: 前缀）─────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="WinUI 2 控件" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="这些不在 UWP 默认 XAML 命名空间，必须走 muxc: —— 新增控件时最容易踩的一处"
                           FontSize="{StaticResource KanesumiLabelSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />

                <muxc:InfoBar IsOpen="True" Severity="Warning" Title="InfoBar"
                              Message="观察其圆角是否也被归零。" />

                <muxc:Expander Header="Expander" HorizontalAlignment="Stretch">
                    <TextBlock Text="展开内容" Margin="0,8,0,8"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                </muxc:Expander>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <muxc:DropDownButton Content="DropDown">
                        <muxc:DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="菜单项一" />
                                <MenuFlyoutItem Text="菜单项二" />
                            </MenuFlyout>
                        </muxc:DropDownButton.Flyout>
                    </muxc:DropDownButton>
                    <muxc:SplitButton Content="Split">
                        <muxc:SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="动作一" />
                            </MenuFlyout>
                        </muxc:SplitButton.Flyout>
                    </muxc:SplitButton>
                    <muxc:ToggleSplitButton Content="ToggleSplit" />
                </StackPanel>

                <muxc:BreadcrumbBar HorizontalAlignment="Left" />

                <muxc:NumberBox Width="180" Value="42" SpinButtonPlacementMode="Compact"
                                HorizontalAlignment="Left" />

                <muxc:RatingControl Value="3" HorizontalAlignment="Left" />

                <muxc:PipsPager NumberOfPages="5" SelectedPageIndex="1"
                                HorizontalAlignment="Left" />

                <!--
                  注意：AutoSuggestBox 是**系统**控件（UWP 自带），不在 muxc: 里。
                  而 InfoBar / Expander / DropDownButton / SplitButton / NumberBox /
                  RatingControl / PipsPager / BreadcrumbBar 是 WinUI 2 新增，必须走 muxc:。
                  这条边界不查编译器就看不出 —— 记下来。
                -->
                <AutoSuggestBox PlaceholderText="自动建议" Width="260"
                                HorizontalAlignment="Left" />
            </StackPanel>

            <!-- ── Overlay 类（走 OverlayCornerRadius）──────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="浮层类" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="默认 8px 圆角，应被 OverlayCornerRadius 归零 —— 这是最容易残留的一类"
                           FontSize="{StaticResource KanesumiLabelSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Flyout">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Flyout 内容" />
                                    <TextBlock Text="默认 8px 圆角" Opacity="0.6" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="MenuFlyout">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="项一" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem Text="子菜单">
                                    <MenuFlyoutItem Text="嵌套项" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="ContentDialog" Click="OnOpenDialog" />
                    <Button Content="TeachingTip" Click="OnOpenTeachingTip" />
                </StackPanel>
            </StackPanel>

            <!-- ── 直角校核尺 ───────────────────────────────────────── -->
            <StackPanel Spacing="10">
                <TextBlock Text="直角校核尺" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                    <Rectangle Width="88" Height="88" Fill="{StaticResource KanesumiPrimaryBrush}" />
                    <Rectangle Width="88" Height="88" Fill="Transparent" StrokeThickness="2"
                               Stroke="{StaticResource KanesumiPrimaryBrush}" />
                    <StackPanel VerticalAlignment="Bottom" Spacing="8">
                        <Rectangle Width="88" Height="3" Fill="{StaticResource KanesumiPrimaryBrush}" />
                        <Rectangle Width="88" Height="1"
                                   Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                        <TextBlock Text="直角 / 描边 / 强调条"
                                   FontSize="{StaticResource KanesumiLabelSize}"
                                   Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Canvas 直角 · 无圆角 · 无渐变 · 无阴影"
                       FontSize="{StaticResource KanesumiCaptionSize}"
                       Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
