<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <Identity
    Name="TakahashiRinta.KanesumiSecW"
    Publisher="CN=TakahashiRinta"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="8f3a2c71-4b6e-4d19-9a52-1e7c0d6b4f38"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Kanesumi · Windows 扇区</DisplayName>
    <PublisherDisplayName>Takahashi Rinta</PublisherDisplayName>
    <!--
      Properties/Logo 走 **StoreLogo** 校验，规范要求恰好 50×50 ——
      与 VisualElements 的 Square150x150Logo 不是同一项。这里踩过一次。
    -->
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Kanesumi.SecW.App">
      <uap:VisualElements
        DisplayName="Kanesumi · Windows 扇区"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Kanesumi Design 的 Windows 扇区 —— 基于 WinUI 2"
        BackgroundColor="#1A1A1A">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\Square71x71Logo.png"
                         Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1A1A1A" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
