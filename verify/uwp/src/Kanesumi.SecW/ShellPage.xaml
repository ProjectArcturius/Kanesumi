<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      应用外壳 —— 标准 UWP 结构：NavigationView 提供导航，Frame 承载页面。

      Kanesumi 的偏离只在一处：**不用 NavigationView 的 PaneHeader / 标题栏 chrome**，
      因为正典约定「顶栏 = 滚动列表第一项」，页面自己出大字标题。
      NavigationView 在这里只承担「导航与选中态」，不承担「标题展示」。

      这不违反正典 —— 正典反对的是**视觉上的 chrome**（边框、背板、分割线），
      不是导航结构本身。
    -->
    <muxc:NavigationView
        x:Name="Nav"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="240"
        IsPaneToggleButtonVisible="True"
        SelectionChanged="OnNavSelectionChanged">

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="会话" Tag="sessions">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="工作区" Tag="workspaces">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem Content="工具调用" Tag="tools">
                <muxc:NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Repair" />
                </muxc:NavigationViewItem.Icon>
            </muxc:NavigationViewItem>
        </muxc:NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" />
    </muxc:NavigationView>
</Page>
