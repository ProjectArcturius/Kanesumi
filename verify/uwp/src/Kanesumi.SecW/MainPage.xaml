<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="{StaticResource KanesumiBackgroundBrush}">

    <!--
      本页刻意是「控件验证台」而不是产品界面。

      理由：WinUI 2 的圆角归零依赖两个全局资源（App.xaml），但**并非所有控件
      都经由它们** —— 自绘控件、部分模板、Flyout 内容各有各的路径。
      与其逐个子类去猜，不如一次性摆出来，肉眼查一遍，把没归零的记进
      docs/UWP_FEEDBACK.md。那正是本扇区最重要的产出。

      布局遵循正典：「顶栏 = 滚动列表第一项」，不是独立 chrome。
      所以这里用 ScrollViewer + StackPanel，而不是 Page.TopAppBar。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 界面外框：无边框、无阴影、纯色分隔 ─────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource KanesumiBackgroundBrush}"
                BorderBrush="{StaticResource KanesumiDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 3px 强调条 —— 设计语言的签名图案（直角切一切） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                    <Rectangle Width="3" Height="20"
                               Fill="{StaticResource KanesumiPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Kanesumi · Windows 扇区"
                               FontSize="{StaticResource KanesumiBodySize}"
                               LineHeight="{StaticResource KanesumiBodyLineHeight}"
                               Foreground="{StaticResource KanesumiOnBackgroundBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="based on Kanesumi Design"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           LineHeight="{StaticResource KanesumiCaptionLineHeight}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="28">

                <!-- 正典：「顶栏 = 滚动列表第一项」。大字页面名就是那个第一项。 -->
                <TextBlock Text="控件验证台"
                           FontSize="{StaticResource KanesumiPageHeadingSize}"
                           LineHeight="{StaticResource KanesumiPageHeadingLineHeight}"
                           Foreground="{StaticResource KanesumiOnBackgroundBrush}" />

                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource KanesumiBodySize}"
                           LineHeight="{StaticResource KanesumiBodyLineHeight}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           Text="下列控件用于验证 ControlCornerRadius / OverlayCornerRadius 的归零是否覆盖全部控件。发现仍有圆角的，记进 docs/UWP_FEEDBACK.md。" />

                <!-- ── 基础输入 ──────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="基础输入"
                               FontSize="{StaticResource KanesumiTitleSize}"
                               LineHeight="{StaticResource KanesumiTitleLineHeight}"
                               Foreground="{StaticResource KanesumiOnBackgroundBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="普通按钮" />
                        <Button Content="强调按钮" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="禁用" IsEnabled="False" />
                        <ToggleButton Content="开关按钮" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBox PlaceholderText="单行文本框 —— 用微软拼音试试中文" Width="320" />
                        <CheckBox Content="复选框" />
                        <RadioButton Content="单选" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox Width="180" SelectedIndex="0">
                            <ComboBoxItem Content="下拉项一" />
                            <ComboBoxItem Content="下拉项二" />
                        </ComboBox>
                        <Slider Width="240" Minimum="0" Maximum="100" Value="40" />
                    </StackPanel>
                </StackPanel>

                <!-- ── 列表与滚动 ────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="列表与滚动"
                               FontSize="{StaticResource KanesumiTitleSize}"
                               LineHeight="{StaticResource KanesumiTitleLineHeight}"
                               Foreground="{StaticResource KanesumiOnBackgroundBrush}" />

                    <!--
                      正典：列表行封面贴屏边（0dp 左 padding）。
                      注意 ListViewItem 的选中背板 —— 它是圆角最容易残留的地方。
                    -->
                    <ListView x:Name="SampleList" Height="180">
                        <ListViewItem Content="贴边行 —— 左 padding 应为 0" />
                        <ListViewItem Content="第二行" />
                        <ListViewItem Content="第三行，用来观察选中背板的圆角" />
                    </ListView>
                </StackPanel>

                <!-- ── 反馈与状态 ────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="反馈与状态"
                               FontSize="{StaticResource KanesumiTitleSize}"
                               LineHeight="{StaticResource KanesumiTitleLineHeight}"
                               Foreground="{StaticResource KanesumiOnBackgroundBrush}" />

                    <ProgressBar Value="45" Width="320" HorizontalAlignment="Left" />

                    <!--
                      InfoBar 是 WinUI 2 新增控件，不在 UWP 的默认 XAML 命名空间里 ——
                      必须走 muxc: 前缀。这与 Button/TextBox 那些系统控件不同，
                      是新增控件时最容易踩的一处。
                    -->
                    <muxc:InfoBar IsOpen="True"
                                  Severity="Informational"
                                  Title="InfoBar"
                                  Message="观察其圆角是否也被 OverlayCornerRadius 归零。" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <!-- Overlay 类：Flyout / ContentDialog 走 OverlayCornerRadius -->
                        <Button Content="打开 Flyout">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Flyout 内容" />
                                        <TextBlock Text="默认 8px 圆角，应被归零。"
                                                   Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="DialogButton" Content="打开 ContentDialog" Click="OnOpenDialog" />
                    </StackPanel>
                </StackPanel>

                <!-- ── 直角校核尺 ────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="直角校核尺"
                               FontSize="{StaticResource KanesumiTitleSize}"
                               LineHeight="{StaticResource KanesumiTitleLineHeight}"
                               Foreground="{StaticResource KanesumiOnBackgroundBrush}" />

                    <!--
                      把 3px 强调条放大到可判别尺寸：若渲染出任何圆角，
                      在这里会以肉眼可辨的缺角显现。
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                        <Rectangle Width="96" Height="96" Fill="{StaticResource KanesumiPrimaryBrush}" />
                        <Rectangle Width="96" Height="96"
                                   Fill="Transparent"
                                   Stroke="{StaticResource KanesumiPrimaryBrush}"
                                   StrokeThickness="2" />
                        <StackPanel VerticalAlignment="Bottom" Spacing="8">
                            <Rectangle Width="96" Height="3" Fill="{StaticResource KanesumiPrimaryBrush}" />
                            <Rectangle Width="96" Height="1" Fill="{StaticResource KanesumiDividerBrush}" />
                            <TextBlock Text="直角 / 描边 / 强调条"
                                       FontSize="{StaticResource KanesumiLabelSize}"
                                       LineHeight="{StaticResource KanesumiLabelLineHeight}"
                                       Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Canvas 直角 · 无圆角 · 无渐变 · 无阴影"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           LineHeight="{StaticResource KanesumiCaptionLineHeight}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           Margin="0,0,0,24" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
