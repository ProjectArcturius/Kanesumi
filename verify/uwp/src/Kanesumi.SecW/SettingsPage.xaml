<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Kanesumi.SecW.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24,32,24,24">
        <StackPanel Spacing="24">
            <StackPanel Spacing="6">
                <TextBlock Text="设置"
                           FontSize="{StaticResource KanesumiPageHeadingSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Text="based on Kanesumi Design"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
            </StackPanel>

            <!-- 色板实况 —— 直接读出资源字典的取值，确认覆盖已生效 -->
            <StackPanel Spacing="10">
                <TextBlock Text="色板" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Rectangle Width="48" Height="24"
                                   Fill="{ThemeResource SystemControlBackgroundAltHighBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource KanesumiCaptionSize}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Text="background  #1A1A1A" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Rectangle Width="48" Height="24"
                                   Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource KanesumiCaptionSize}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Text="surface  #242424" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Rectangle Width="48" Height="24"
                                   Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource KanesumiCaptionSize}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Text="divider  #3A3A3A" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Rectangle Width="48" Height="24"
                                   Fill="{ThemeResource SystemControlBackgroundAccentBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource KanesumiCaptionSize}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Text="primary  #E57812   （一屏一色）" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- 几何 -->
            <StackPanel Spacing="10">
                <TextBlock Text="几何" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="0" Padding="14,12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="圆角：ControlCornerRadius = 0 / OverlayCornerRadius = 0"
                                   FontSize="{StaticResource KanesumiCaptionSize}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="{StaticResource KanesumiLabelSize}"
                                   Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                                   Text="这两个全局资源控制全部控件，在 App.xaml 覆盖即得直角，无需重写控件模板。" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 关于 -->
            <StackPanel Spacing="10">
                <TextBlock Text="关于本工程" FontSize="{StaticResource KanesumiTitleSize}"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource KanesumiCaptionSize}"
                           Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}"
                           Text="这不是产品，是取数用的隔离工程：在真 UWP 上跑 Kanesumi 的控件与动画，实测官方默认值、真实视觉状态机与边界情况，结论回流到主仓的 CONTROL_SPEC.md / ANIMATION_SPEC.md。规格是资产，跑规格的工程不是。" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource SystemControlForegroundBaseLowBrush}" />

            <TextBlock Text="Kanesumi Design · Windows 实现验证"
                       FontSize="{StaticResource KanesumiLabelSize}"
                       Foreground="{StaticResource KanesumiOnSurfaceVariantBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
